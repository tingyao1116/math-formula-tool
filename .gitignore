# Local editor / environment
.vscode/
.venv-word/
logs/

# Python cache
**/__pycache__/
*.pyc

# Temporary compare / scratch
tmp-docx-compare/
tmp-docx-render-skill/

# Backups and exports are not part of the formal sync target
backups/
exports/
program-db/exports/

# Local sqlite / test artifacts
program-db/database/*.sqlite3
program-db/database/write-test.txt

# Raw source docs and inspect packs are intermediate only
program-db/imports/raw/
program-db/imports/packs/_inspect-*/

# Keep formal packs, but ignore their intermediate byproducts
program-db/imports/packs/*/source/
program-db/imports/packs/*/extracted/
program-db/imports/packs/*/assets/
program-db/imports/packs/*/preview.json
program-db/imports/packs/*/_write_test.tmp
program-db/imports/packs/*/review-needed.md
program-db/imports/packs/*/notes.md
